request.url: https://{{controller_host}}:{{controller_port}}/proxy/network/api/s/{{site_name}}/stat/device
request.method: GET
request.ssl.verification_mode: {{#if verify_ssl}}full{{else}}none{{/if}}
request.timeout: 30s
request.transforms:
  - set:
      target: header.X-API-KEY
      value: {{api_key}}
  - set:
      target: header.Accept
      value: application/json

response.split:
  target: body.data
  type: array

response.transforms:
  - set:
      target: body.site_name
      value: "{{site_name}}"
  - set:
      target: body.observer_host
      value: "{{controller_host}}"

interval: {{collection_interval}}
request.retry.max_attempts: 3
request.retry.wait_min: 1s

processors:
  # Filter to only APs and extract radio_table_stats to top level
  - script:
      lang: javascript
      source: |
        function process(event) {
          var device = event.Get("data");
          if (!device || device.type !== "uap" || !device.radio_table_stats || !Array.isArray(device.radio_table_stats)) {
            event.Cancel();
            return;
          }
          event.Put("device_context", {
            "id": device._id,
            "mac": device.mac,
            "name": device.name
          });
          event.Put("radios", device.radio_table_stats);
        }
  # Split into one event per radio
  - split:
      field: radios
      target: radio
  # Build the radio event structure
  - script:
      lang: javascript
      source: |
        function process(event) {
          var radio = event.Get("radio");
          var deviceCtx = event.Get("device_context");
          var siteName = event.Get("site_name");
          var observerHost = event.Get("observer_host");

          event.Put("device", {
            "id": deviceCtx.id,
            "mac": deviceCtx.mac,
            "name": deviceCtx.name,
            "type": "access-point"
          });

          event.Put("unifi", {
            "site": {"name": siteName},
            "device": {"type": "uap"},
            "radio": {
              "name": radio.name,
              "radio": radio.radio,
              "channel": radio.channel,
              "tx_power": radio.tx_power,
              "utilization": {
                "total": radio.cu_total,
                "self_rx": radio.cu_self_rx,
                "self_tx": radio.cu_self_tx
              },
              "clients": {"count": radio.num_sta},
              "satisfaction": radio.satisfaction,
              "state": radio.state
            }
          });

          event.Put("observer", {
            "type": "unifi-controller",
            "ip": observerHost
          });
        }
  - add_fields:
      target: ''
      fields:
        ecs.version: 8.11.0
        event.dataset: unifi.radio_metrics
        event.module: unifi
        event.kind: metric
  - drop_fields:
      fields:
        - data
        - radio
        - radios
        - device_context
        - site_name
        - observer_host
      ignore_missing: true
