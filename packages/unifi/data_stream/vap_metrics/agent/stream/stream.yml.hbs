request.url: https://{{controller_host}}:{{controller_port}}/proxy/network/api/s/{{site_name}}/stat/device
request.method: GET
request.ssl.verification_mode: {{#if verify_ssl}}full{{else}}none{{/if}}
request.timeout: 30s
request.transforms:
  - set:
      target: header.X-API-KEY
      value: {{api_key}}
  - set:
      target: header.Accept
      value: application/json

response.split:
  target: body.data
  type: array

response.transforms:
  - set:
      target: body.site_name
      value: "{{site_name}}"

interval: {{collection_interval}}
request.retry.max_attempts: 3

processors:
  - script:
      lang: javascript
      source: |
        function process(event) {
          var device = event.Get("data");
          if (!device || device.type !== "uap" || !device.vap_table) {
            event.Cancel();
            return;
          }

          var vaps = device.vap_table;
          var vapEvents = [];

          for (var i = 0; i < vaps.length; i++) {
            var vap = vaps[i];
            vapEvents.push({
              "device": {"id": device._id, "mac": device.mac, "name": device.name, "type": "access-point"},
              "unifi": {
                "site": {"name": event.Get("site_name")},
                "device": {"type": "uap"},
                "vap": {
                  "id": vap.id,
                  "name": vap.name,
                  "ssid": vap.essid,
                  "bssid": vap.bssid,
                  "radio": vap.radio,
                  "channel": vap.channel,
                  "clients": {"count": vap.num_sta},
                  "bytes": {"rx": vap.rx_bytes || 0, "tx": vap.tx_bytes || 0},
                  "packets": {"rx": vap.rx_packets || 0, "tx": vap.tx_packets || 0},
                  "errors": {"rx": vap.rx_errors || 0, "tx": vap.tx_errors || 0},
                  "dropped": {"rx": vap.rx_dropped || 0, "tx": vap.tx_dropped || 0},
                  "satisfaction": vap.satisfaction
                }
              }
            });
          }

          if (vapEvents.length > 0) event.Put("vap_events", vapEvents);
          else event.Cancel();
        }
  - script:
      lang: javascript
      source: |
        function process(event) {
          var vapEvents = event.Get("vap_events");
          if (!vapEvents || vapEvents.length === 0) {
            event.Cancel();
            return;
          }
          for (var key in vapEvents[0]) {
            event.Put(key, vapEvents[0][key]);
          }
          if (vapEvents.length > 1) {
            event.Put("vap_events", vapEvents.slice(1));
          }
        }
  - add_fields:
      target: ''
      fields:
        ecs.version: 8.11.0
        event.dataset: unifi.vap_metrics
        event.module: unifi
        event.kind: metric
        observer.type: unifi-controller
  - drop_fields:
      fields: [data, vap_events, site_name]
      ignore_missing: true
