request.url: https://{{controller_host}}:{{controller_port}}/proxy/network/api/s/{{site_name}}/stat/device
request.method: GET
request.ssl.verification_mode: {{#if verify_ssl}}full{{else}}none{{/if}}
request.timeout: 30s
request.transforms:
  - set:
      target: header.X-API-KEY
      value: {{api_key}}
  - set:
      target: header.Accept
      value: application/json

response.split:
  target: body.data
  type: array

response.transforms:
  - set:
      target: body.site_name
      value: "{{site_name}}"

interval: {{collection_interval}}
request.retry.max_attempts: 3

processors:
  # Filter to only APs and extract vap_table to top level
  - script:
      lang: javascript
      source: |
        function process(event) {
          var device = event.Get("data");
          if (!device || device.type !== "uap" || !device.vap_table || !Array.isArray(device.vap_table)) {
            event.Cancel();
            return;
          }
          event.Put("device_context", {
            "id": device._id,
            "mac": device.mac,
            "name": device.name
          });
          event.Put("vaps", device.vap_table);
        }
  # Split into one event per VAP
  - split:
      field: vaps
      target: vap
  # Build the VAP event structure
  - script:
      lang: javascript
      source: |
        function process(event) {
          var vap = event.Get("vap");
          var deviceCtx = event.Get("device_context");
          var siteName = event.Get("site_name");

          event.Put("device", {
            "id": deviceCtx.id,
            "mac": deviceCtx.mac,
            "name": deviceCtx.name,
            "type": "access-point"
          });

          event.Put("unifi", {
            "site": {"name": siteName},
            "device": {"type": "uap"},
            "vap": {
              "id": vap.id,
              "name": vap.name,
              "ssid": vap.essid,
              "bssid": vap.bssid,
              "radio": vap.radio,
              "channel": vap.channel,
              "clients": {"count": vap.num_sta},
              "bytes": {"rx": vap.rx_bytes || 0, "tx": vap.tx_bytes || 0},
              "packets": {"rx": vap.rx_packets || 0, "tx": vap.tx_packets || 0},
              "errors": {"rx": vap.rx_errors || 0, "tx": vap.tx_errors || 0},
              "dropped": {"rx": vap.rx_dropped || 0, "tx": vap.tx_dropped || 0},
              "satisfaction": vap.satisfaction
            }
          });

          event.Put("observer", {"type": "unifi-controller"});
        }
  - add_fields:
      target: ''
      fields:
        ecs.version: 8.11.0
        event.dataset: unifi.vap_metrics
        event.module: unifi
        event.kind: metric
  - drop_fields:
      fields:
        - data
        - vap
        - vaps
        - device_context
        - site_name
      ignore_missing: true
