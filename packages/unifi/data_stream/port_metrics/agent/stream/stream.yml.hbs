request.url: https://{{controller_host}}:{{controller_port}}/proxy/network/api/s/{{site_name}}/stat/device
request.method: GET
request.ssl.verification_mode: {{#if verify_ssl}}full{{else}}none{{/if}}
request.timeout: 30s
request.transforms:
  - set:
      target: header.X-API-KEY
      value: {{api_key}}
  - set:
      target: header.Accept
      value: application/json

# Split by devices first
response.split:
  target: body.data
  type: array
  keep_parent: false

response.transforms:
  # Keep site context
  - set:
      target: body.unifi_site_name
      value: "{{site_name}}"
  - set:
      target: body.observer_host
      value: "{{controller_host}}"

interval: {{collection_interval}}

request.retry.max_attempts: 3
request.retry.wait_min: 1s
request.retry.wait_max: 60s

processors:
  # Filter to only switches and extract port_table to top level
  - script:
      lang: javascript
      source: |
        function process(event) {
          var device = event.Get("data");
          if (!device || device.type !== "usw" || !device.port_table || !Array.isArray(device.port_table)) {
            event.Cancel();
            return;
          }
          // Store device context
          event.Put("device_context", {
            "id": device._id,
            "mac": device.mac,
            "name": device.name
          });
          // Move port_table to top level for split processor
          event.Put("ports", device.port_table);
        }
  # Split into one event per port
  - split:
      field: ports
      target: port
  # Build the port event structure
  - script:
      lang: javascript
      source: |
        function process(event) {
          var port = event.Get("port");
          var deviceCtx = event.Get("device_context");
          var siteName = event.Get("unifi_site_name");
          var observerHost = event.Get("observer_host");

          event.Put("device", {
            "id": deviceCtx.id,
            "mac": deviceCtx.mac,
            "name": deviceCtx.name,
            "type": "switch"
          });

          event.Put("unifi", {
            "site": {"name": siteName},
            "device": {"type": "usw"},
            "port": {
              "id": port.port_idx,
              "number": port.port_idx,
              "name": port.name || "Port " + port.port_idx,
              "enabled": port.enabled || port.enable || false,
              "up": port.up || false,
              "speed": port.speed,
              "duplex": port.full_duplex ? "full" : "half",
              "is_uplink": port.is_uplink || false,
              "bytes": {
                "rx": port.rx_bytes || 0,
                "tx": port.tx_bytes || 0,
                "rate": port["bytes-r"] || 0,
                "rx_rate": port["rx_bytes-r"] || 0,
                "tx_rate": port["tx_bytes-r"] || 0
              },
              "packets": {
                "rx": port.rx_packets || 0,
                "tx": port.tx_packets || 0,
                "rx_broadcast": port.rx_broadcast || 0,
                "rx_multicast": port.rx_multicast || 0,
                "tx_broadcast": port.tx_broadcast || 0,
                "tx_multicast": port.tx_multicast || 0
              },
              "errors": {
                "rx": port.rx_errors || 0,
                "tx": port.tx_errors || 0
              },
              "dropped": {
                "rx": port.rx_dropped || 0,
                "tx": port.tx_dropped || 0
              },
              "satisfaction": port.satisfaction,
              "satisfaction_reason": port.satisfaction_reason,
              "link_down_count": port.link_down_count || 0,
              "mac_table_count": port.mac_table_count || 0
            }
          });

          // PoE fields if available
          if (port.port_poe || port.poe_enable) {
            var unifiData = event.Get("unifi");
            unifiData.port.poe = {
              "enabled": port.port_poe || port.poe_enable || false,
              "power": port.poe_power,
              "voltage": port.poe_voltage
            };
            event.Put("unifi", unifiData);
          }

          // STP fields
          if (port.stp_state) {
            var unifiData = event.Get("unifi");
            unifiData.port.stp = {"state": port.stp_state};
            event.Put("unifi", unifiData);
          }

          event.Put("observer", {
            "type": "unifi-controller",
            "ip": observerHost
          });
        }
  - add_fields:
      target: ''
      fields:
        ecs.version: 8.11.0
        event.dataset: unifi.port_metrics
        event.module: unifi
        event.kind: metric
  - drop_fields:
      fields:
        - data
        - port
        - ports
        - device_context
        - unifi_site_name
        - observer_host
      ignore_missing: true
